# Copy this file to .env.local for local use. Never commit .env.local.

# --- Supabase (database + login) ---
# Supabase dashboard > Project Settings > API
# These two are public by design (protected by Row Level Security).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Resend (email) --- server side only, never VITE_ prefixed!
RESEND_API_KEY=
# Sender address on a domain verified in Resend, e.g. "Chris <vacation@your-domain.com>".
# Without a verified domain Resend only delivers to your own Resend account email.
RESEND_FROM=
# Optional: comma separated list of allowed recipients (your manager's address).
ALLOWED_RECIPIENTS=

# --- Server-side copies for the email function (Vercel) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
